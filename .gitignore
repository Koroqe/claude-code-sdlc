.DS_Store
.vscode/
.claude/tmp/

# install.sh --local --profile <name> receipt — a local install artifact
# recording which model profile was last applied to agents/*.md. Committing
# it would let a contributor's rewritten tree pass the CI drift check that
# exists to catch exactly that mismatch.
/.sdlc-model-profile

# Per-worktree pipeline session state — live local state, never merged, never
# committed (PRD §15 FR-1). Parallel worktrees each carry their own copy;
# tracking it was the single biggest merge-collision source between parallel
# feature branches. Curated project knowledge (.claude/instincts.md) stays
# tracked — this entry is scoped to the scratchpad alone.
/.claude/scratchpad.md

# Transient wave-record and debugger state written by the harness's own hooks
# during a run — never curated project knowledge (unlike .claude/instincts.md,
# which stays tracked). The leading slash is stylistic,
# matching the /.sdlc-model-profile convention above: per measured gitignore
# semantics (docs/findings/remeasurement-2.1.237.md §5), any pattern with a
# middle separator is already root-relative, so the anchor adds explicitness,
# not protection. The genuinely dangerous shape is a separator-free pattern
# like `debug/`, which matches at ANY depth and would shadow the tracked
# fixtures under tests/fixtures/agents/debugger/.
/.claude/debug/

# Behavioural eval run artifacts — the durable numbers go in docs/findings/, not here.
/evals/results/
